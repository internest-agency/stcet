generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_EDITOR
}

model AdminUser {
  id             Int               @id @default(autoincrement())
  name           String            @db.VarChar(120)
  email          String            @unique @db.VarChar(191)
  passwordHash   String            @db.VarChar(255)
  role           AdminRole         @default(CONTENT_EDITOR)
  isActive       Boolean           @default(true)
  sessionVersion Int               @default(0)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @db.DateTime(3)
  auditLogs      AdminAuditLog[]
  uploadedMedia  MediaAsset[]
}

model AdminLoginAttempt {
  emailHash       String    @id @db.Char(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @db.DateTime(3)
  blockedUntil    DateTime? @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
}

model AdminAuditLog {
  id         Int       @id @default(autoincrement())
  actorId    Int?
  action     String    @db.VarChar(40)
  entityType String    @db.VarChar(80)
  entityId   String    @db.VarChar(80)
  details    Json?
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Course {
  id                Int                @id @default(autoincrement())
  name              String             @db.VarChar(191)
  slug              String             @unique @db.VarChar(191)
  degree            String             @db.VarChar(80)
  tagline           String?            @db.VarChar(255)
  description       String?            @db.Text
  heroImage         String?            @db.VarChar(2048)
  seoTitle          String?            @db.VarChar(191)
  metaDescription   String?            @db.VarChar(320)
  canonicalUrl      String?            @db.VarChar(2048)
  ogImage           String?            @db.VarChar(2048)
  noIndex           Boolean            @default(false)
  isPublished       Boolean            @default(false)
  createdAt         DateTime           @default(now()) @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @db.DateTime(3)
  modules           CourseModule[]
  opportunities     CourseOpportunity[]
  reasons           CourseReason[]
  careerPathways    CareerPathway[]
  futurePaths       FuturePath[]

  @@index([isPublished, name])
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  courseId    Int
  number      Int
  title       String   @db.VarChar(191)
  description String   @db.Text
  image       String   @db.VarChar(2048)
  sortOrder   Int      @default(0)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([courseId, number])
  @@index([courseId, sortOrder])
}

model CourseOpportunity {
  id        Int    @id @default(autoincrement())
  courseId  Int
  title     String @db.VarChar(191)
  sortOrder Int    @default(0)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([courseId, sortOrder])
}

model CourseReason {
  id          Int    @id @default(autoincrement())
  courseId    Int
  number      Int
  title       String @db.VarChar(191)
  description String @db.Text
  sortOrder   Int    @default(0)
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([courseId, number])
  @@index([courseId, sortOrder])
}

model CareerPathway {
  id        Int         @id @default(autoincrement())
  courseId  Int
  number    Int
  title     String      @db.VarChar(191)
  image     String      @db.VarChar(2048)
  sortOrder Int         @default(0)
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roles     CareerRole[]

  @@unique([courseId, number])
  @@index([courseId, sortOrder])
}

model CareerRole {
  id               Int           @id @default(autoincrement())
  careerPathwayId  Int
  role             String        @db.VarChar(191)
  sortOrder        Int           @default(0)
  careerPathway    CareerPathway @relation(fields: [careerPathwayId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([careerPathwayId, sortOrder])
}

model FuturePath {
  id          Int    @id @default(autoincrement())
  courseId    Int
  number      Int
  title       String @db.VarChar(191)
  description String @db.Text
  sortOrder   Int    @default(0)
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([courseId, number])
  @@index([courseId, sortOrder])
}

model MediaAsset {
  id           Int       @id @default(autoincrement())
  path         String    @unique @db.VarChar(2048)
  contentType  String    @db.VarChar(80)
  size         Int
  altText      String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  uploadedById Int
  uploadedBy   AdminUser @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([uploadedById, createdAt])
}

model GalleryCategory {
  id        Int           @id @default(autoincrement())
  name      String        @unique @db.VarChar(80)
  slug      String        @unique @db.VarChar(96)
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now()) @db.DateTime(3)
  updatedAt DateTime      @updatedAt @db.DateTime(3)
  images    GalleryImage[]

  @@index([isActive, sortOrder])
}

model GalleryImage {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(191)
  altText     String         @db.VarChar(255)
  categoryId  Int
  imagePath   String         @unique @db.VarChar(2048)
  isPublished Boolean        @default(false)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  category    GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([isPublished, categoryId, sortOrder])
}