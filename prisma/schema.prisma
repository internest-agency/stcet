generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_EDITOR
}

model AdminUser {
  @@map("adminuser")
  id             Int               @id @default(autoincrement())
  name           String            @db.VarChar(120)
  email          String            @unique @db.VarChar(191)
  passwordHash   String            @db.VarChar(255)
  role           AdminRole         @default(CONTENT_EDITOR)
  isActive       Boolean           @default(true)
  sessionVersion Int               @default(0)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @db.DateTime(3)
  auditLogs      AdminAuditLog[]
  uploadedMedia  MediaAsset[]
}

model AdminLoginAttempt {
  @@map("adminloginattempt")
  emailHash       String    @id @db.Char(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @db.DateTime(3)
  blockedUntil    DateTime? @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
}

model AdminAuditLog {
  @@map("adminauditlog")
  id         Int       @id @default(autoincrement())
  actorId    Int?
  action     String    @db.VarChar(40)
  entityType String    @db.VarChar(80)
  entityId   String    @db.VarChar(80)
  details    Json?
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Course {
  @@map("course")
  id                Int                @id @default(autoincrement())
  name              String             @db.VarChar(191)
  slug              String             @unique @db.VarChar(191)
  degree            String             @db.VarChar(80)
  tagline           String?            @db.VarChar(255)
  description       String?            @db.Text
  heroImage         String?            @db.VarChar(2048)
  overviewHeading   String?            @db.VarChar(255)
  overviewKeyStatement String?         @db.Text
  curriculumTitle   String?            @db.VarChar(255)
  curriculumIntro   String?            @db.Text
  opportunityTitle  String?            @db.VarChar(255)
  whyStudyLabel     String?            @db.VarChar(191)
  whyStudyHeading   String?            @db.VarChar(255)
  whyStudyIntro     String?            @db.Text
  careerTitle       String?            @db.VarChar(255)
  careerIntro       String?            @db.Text
  seoTitle          String?            @db.VarChar(191)
  metaDescription   String?            @db.VarChar(320)
  canonicalUrl      String?            @db.VarChar(2048)
  ogImage           String?            @db.VarChar(2048)
  noIndex           Boolean            @default(false)
  isPublished       Boolean            @default(false)
  createdAt         DateTime           @default(now()) @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @db.DateTime(3)
  modules           CourseModule[]
  opportunities     CourseOpportunity[]
  reasons           CourseReason[]
  careerPathways    CareerPathway[]
  futurePaths       FuturePath[]
  admissionRoutes   AdmissionRoute[]
  trainingProgrammes TrainingProgramme[]
  industryInteractions IndustryInteraction[]

  @@index([isPublished, name])
}

model CourseModule {
  @@map("coursemodule")
  id          Int      @id @default(autoincrement())
  courseId    Int
  number      Int
  title       String   @db.VarChar(191)
  description String   @db.Text
  image       String   @db.VarChar(2048)
  sortOrder   Int      @default(0)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([courseId, number])
  @@index([courseId, sortOrder])
}

model CourseOpportunity {
  @@map("courseopportunity")
  id        Int    @id @default(autoincrement())
  courseId  Int
  title     String @db.VarChar(191)
  sortOrder Int    @default(0)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([courseId, sortOrder])
}

model CourseReason {
  @@map("coursereason")
  id          Int    @id @default(autoincrement())
  courseId    Int
  number      Int
  title       String @db.VarChar(191)
  description String @db.Text
  sortOrder   Int    @default(0)
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([courseId, number])
  @@index([courseId, sortOrder])
}

model CareerPathway {
  @@map("careerpathway")
  id        Int         @id @default(autoincrement())
  courseId  Int
  number    Int
  title     String      @db.VarChar(191)
  image     String      @db.VarChar(2048)
  sortOrder Int         @default(0)
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roles     CareerRole[]

  @@unique([courseId, number])
  @@index([courseId, sortOrder])
}

model CareerRole {
  @@map("careerrole")
  id               Int           @id @default(autoincrement())
  careerPathwayId  Int
  role             String        @db.VarChar(191)
  sortOrder        Int           @default(0)
  careerPathway    CareerPathway @relation(fields: [careerPathwayId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([careerPathwayId, sortOrder])
}

model FuturePath {
  @@map("futurepath")
  id          Int    @id @default(autoincrement())
  courseId    Int
  number      Int
  title       String @db.VarChar(191)
  description String @db.Text
  sortOrder   Int    @default(0)
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([courseId, number])
  @@index([courseId, sortOrder])
}

model MediaAsset {
  @@map("mediaasset")
  id           Int       @id @default(autoincrement())
  path         String    @unique @db.VarChar(2048)
  contentType  String    @db.VarChar(80)
  size         Int
  title        String?   @db.VarChar(191)
  altText      String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  uploadedById Int
  uploadedBy   AdminUser @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([uploadedById, createdAt])
}

model GalleryCategory {
  @@map("gallerycategory")
  id        Int           @id @default(autoincrement())
  name      String        @unique @db.VarChar(80)
  slug      String        @unique @db.VarChar(96)
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now()) @db.DateTime(3)
  updatedAt DateTime      @updatedAt @db.DateTime(3)
  images    GalleryImage[]

  @@index([isActive, sortOrder])
}

model GalleryImage {
  @@map("galleryimage")
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(191)
  altText     String         @db.VarChar(255)
  categoryId  Int
  imagePath   String         @unique @db.VarChar(2048)
  isPublished Boolean        @default(false)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  category    GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([isPublished, categoryId, sortOrder])
}

model AdmissionsIntro {
  @@map("admissionsintro")
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(191)
  subtitle    String?        @db.VarChar(255)
  description String?        @db.Text
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
}

model AdmissionRoute {
  @@map("admissionroute")
  id          Int            @id @default(autoincrement())
  courseId    Int?
  number      String?        @db.VarChar(10)
  title       String         @db.VarChar(191)
  description String?        @db.Text
  imagePath   String?        @db.VarChar(2048)
  linkHref    String?        @db.VarChar(2048)
  linkText    String?        @db.VarChar(100)
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([isPublished, sortOrder])
}

model TNEACounselling {
  @@map("tneacounselling")
  id           Int      @id @default(autoincrement())
  stepNumber   Int
  title        String   @db.VarChar(191)
  description  String?  @db.Text
  instructions Json?
  imagePath    String?  @db.VarChar(2048)
  imageLabel   String?  @db.VarChar(191)
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
}

model ManagementQuotaInfo {
  @@map("managementquotainfo")
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(191)
  description String?        @db.Text
  eligibility String?        @db.Text
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
}

model AdmissionDocuments {
  @@map("admissiondocuments")
  id          Int            @id @default(autoincrement())
  category    String?        @db.VarChar(100)
  title       String         @db.VarChar(191)
  description String?        @db.Text
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
}

model ImportantNotices {
  @@map("importantnotices")
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(191)
  content     String         @db.Text
  linkUrl     String?        @db.VarChar(2048)
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
}

model ApplicationLink {
  @@map("applicationlink")
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(191)
  url         String         @db.VarChar(2048)
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
}

model AdmissionContact {
  @@map("admissioncontact")
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(191)
  value       String         @db.VarChar(255)
  contactType String?        @db.VarChar(50)
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
}

model Scholarship {
  @@map("scholarship")
  id                      Int            @id @default(autoincrement())
  name                    String         @db.VarChar(191)
  description             String?        @db.Text
  eligibility             String?        @db.Text
  financialBenefit        String?        @db.Text
  incomeLimit             String?        @db.Text
  applicationInstructions String?        @db.Text
  applicationUrl          String?        @db.VarChar(2048)
  sortOrder               Int            @default(0)
  isPublished             Boolean        @default(true)
  createdAt               DateTime       @default(now()) @db.DateTime(3)
  updatedAt               DateTime       @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
}

model PlacementCompany {
  @@map("placementcompany")
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(191)
  slug        String         @unique @db.VarChar(191)
  websiteUrl  String?        @db.VarChar(2048)
  logoPath    String?        @db.VarChar(2048)
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
}

model TrainingProgramme {
  @@map("trainingprogramme")
  id          Int            @id @default(autoincrement())
  courseId    Int?
  title       String         @db.VarChar(191)
  description String?        @db.Text
  imagePath   String?        @db.VarChar(2048)
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([isPublished, sortOrder])
}

model IndustryInteraction {
  @@map("industryinteraction")
  id          Int            @id @default(autoincrement())
  courseId    Int?
  title       String         @db.VarChar(191)
  description String?        @db.Text
  imagePath   String?        @db.VarChar(2048)
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([isPublished, sortOrder])
}

model InfrastructureFacility {
  @@map("infrastructurefacility")
  id          Int            @id @default(autoincrement())
  category    String         @db.VarChar(100)
  sectionId   String?        @db.VarChar(50)
  layout      String?        @db.VarChar(100)
  title       String         @db.VarChar(191)
  description String?        @db.Text
  imagePath   String?        @db.VarChar(2048)
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  @@index([category, isPublished, sortOrder])
}

model Committee {
  @@map("committee")
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(191)
  pageTitle   String   @db.VarChar(191)
  introduction String? @db.Text
  heroImage   String?  @db.VarChar(2048)
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
}

model CommitteeMember {
  @@map("committeemember")
  id            Int            @id @default(autoincrement())
  committeeSlug String         @db.VarChar(100)
  committeeName String         @db.VarChar(191)
  memberName    String         @db.VarChar(191)
  designation   String?        @db.VarChar(191)
  role          String?        @db.VarChar(100)
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @db.DateTime(3)

  @@index([committeeSlug, isPublished, sortOrder])
}

model InstitutionalPage {
  @@map("institutionalpage")
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(191)
  slug            String         @unique @db.VarChar(191)
  introduction    String?        @db.Text
  seoTitle        String?        @db.VarChar(191)
  metaDescription String?        @db.VarChar(320)
  sortOrder       Int            @default(0)
  isPublished     Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @db.DateTime(3)
  sections        PageSection[]

  @@index([isPublished, sortOrder])
}

model PageSection {
  @@map("pagesection")
  id          Int               @id @default(autoincrement())
  pageId      Int
  title       String            @db.VarChar(191)
  content     String?           @db.Text
  imagePath   String?           @db.VarChar(2048)
  layout      String            @default("standard") @db.VarChar(32)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now()) @db.DateTime(3)
  updatedAt   DateTime          @updatedAt @db.DateTime(3)
  page        InstitutionalPage @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([pageId, sortOrder])
}

model GeneralPage {
  @@map("generalpage")
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(191)
  slug            String         @unique @db.VarChar(191)
  introduction    String?        @db.Text
  content         String?        @db.Text
  imagePath       String?        @db.VarChar(2048)
  ctaLabel        String?        @db.VarChar(100)
  ctaUrl          String?        @db.VarChar(2048)
  seoTitle        String?        @db.VarChar(191)
  metaDescription String?        @db.VarChar(320)
  sortOrder       Int            @default(0)
  isPublished     Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
}

model MenuItem {
  @@map("menuitem")
  id          Int            @id @default(autoincrement())
  parentId    Int?
  title       String         @db.VarChar(191)
  url         String         @db.VarChar(2048)
  type        String         @default("link") @db.VarChar(50)
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  openInNewTab Boolean       @default(false)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  parent      MenuItem?      @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[]     @relation("MenuHierarchy")

  @@index([isActive, sortOrder])
}

model PageSeo {
  @@map("pageseo")
  id              Int      @id @default(autoincrement())
  pagePath        String   @unique @db.VarChar(191)
  pageTitle       String   @db.VarChar(191)
  seoTitle        String?  @db.VarChar(191)
  metaDescription String?  @db.VarChar(320)
  canonicalUrl    String?  @db.VarChar(2048)
  ogImage         String?  @db.VarChar(2048)
  noIndex         Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)
}

model SiteSettings {
  @@map("sitesettings")
  id                     Int            @id @default(autoincrement())
  collegeName            String         @db.VarChar(191)
  logoPath               String?        @db.VarChar(2048)
  faviconPath            String?        @db.VarChar(2048)
  contactEmail           String?        @db.VarChar(255)
  phoneNumber            String?        @db.VarChar(50)
  alternativePhone       String?        @db.VarChar(50)
  address                String?        @db.Text
  socialLinks            Json?
  footerLinks            Json?
  footerText             String?        @db.Text
  defaultSeoTitle        String?        @db.VarChar(191)
  defaultMetaDescription String?        @db.VarChar(320)
  createdAt              DateTime       @default(now()) @db.DateTime(3)
  updatedAt              DateTime       @updatedAt @db.DateTime(3)
}

model Faculty {
  @@map("faculty")
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(191)
  designation    String    @db.VarChar(191)
  department     String?   @db.VarChar(191)
  auFin          String?   @db.VarChar(64)
  aicteId        String?   @db.VarChar(128)
  qualification  String?   @db.VarChar(255)
  specialization String?   @db.VarChar(255)
  experience     Float?
  email          String?   @db.VarChar(191)
  phone          String?   @db.VarChar(50)
  photo          String?   @db.VarChar(2048)
  bio            String?   @db.Text
  sortOrder      Int       @default(0)
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  @@index([isPublished, sortOrder])
  @@index([designation])
  @@index([auFin])
}

model Enquiry {
  @@map("enquiry")
  id                 Int      @id @default(autoincrement())
  enquiryNumber      String   @unique

  studentName        String
  dateOfBirth        String
  studentMobile      String
  studentEmail       String
  category           String   @default("")
  hostelRequired     String   @default("")
  transportRequired  String   @default("")

  parentName         String
  occupation         String   @default("")
  parentMobile       String
  parentEmail        String   @default("")
  annualIncome       String   @default("")
  address            String   @db.Text

  tenthSchool        String   @default("")
  tenthBoard         String   @default("")
  tenthMarks         String   @default("")

  twelfthSchool      String   @default("")
  twelfthBoard       String   @default("")
  mathsMarks         String   @default("")
  physicsMarks       String   @default("")
  chemistryMarks     String   @default("")
  mpcPercentage      String   @default("")
  tneaCounselling    String   @default("")

  coursePreference1  String   @default("")
  coursePreference2  String   @default("")
  coursePreference3  String   @default("")
  coursePreference4  String   @default("")
  coursePreference5  String   @default("")

  howDidYouKnow      String   @default("")
  clientIp           String   @default("unknown")

  status             String   @default("New") @db.VarChar(50)
  adminNotes         String?  @db.Text

  submittedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([studentName])
  @@index([studentMobile])
  @@index([studentEmail])
  @@index([submittedAt])
}

model ContactMessage {
  @@map("contactmessage")
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(191)
  email     String   @db.VarChar(191)
  phone     String   @db.VarChar(50)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  clientIp  String   @default("unknown") @db.VarChar(100)

  status    String   @default("New") @db.VarChar(50)
  adminNotes String?  @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([status])
  @@index([email])
  @@index([createdAt])
}
