DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
NEXTAUTH_SECRET="generate-a-unique-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Public origin used to resolve canonical/Open Graph URLs (metadataBase). Set to
# the real HTTPS origin in production, e.g. https://www.stcet.ac.in
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
DATABASE_CONNECT_TIMEOUT_MS="5000"
# Pool tuning for shared MySQL hosts. Idle connections are recycled well before
# the server's wait_timeout (often 300s) so reused sockets are never half-open,
# which is the usual cause of "read ECONNRESET".
DATABASE_CONNECTION_LIMIT="5"
# Must be >= 1. Setting 0 makes the mariadb driver never open a connection at
# all (a known driver bug), which surfaces as a permanent 45028
# "pool timeout ... active=0 idle=0 limit=N" on every query.
DATABASE_MIN_IDLE="1"
DATABASE_IDLE_TIMEOUT_MS="60000"
DATABASE_PING_TIMEOUT_MS="1000"
UPLOAD_MAX_BYTES="5242880"
